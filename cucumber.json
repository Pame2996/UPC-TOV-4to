{
  "default":{
      "timeout": 300000,
      "paths": ["src/tests/features/login.feature"],
      "formatOptions": {
          "snippetInterface": "async-await"
      },
      "require": [
          "src/tests/steps/loginSteps.ts",
          "src/hooks/hooks.ts"
      ],
      "requireModule": ["ts-node/register"],
      "format": [
          "html:test-result/report/cucumber-report.html",
          "json:test-result/report/cucumber-report.json",
          "rerun:@rerun.txt"
      ],
      "parallel": 1,
      "retry": 0
  },
  "rerun":{
      "formatOptions": {
          "snippetInterface": "async-await"
      },
      "require": [
          "src/tests/steps/loginSteps.ts",
          "src/hooks/hooks.ts"
      ],
      "requireModule": ["ts-node/register"],
      "format": [
          "html:test-result/report/cucumber-report.html",
          "json:test-result/report/cucumber-report.json",
          "rerun:@rerun.txt"
      ],
      "parallel": 1
  }
}